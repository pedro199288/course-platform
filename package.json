    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^4.5.0",
    "stripe": "^22.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6"
