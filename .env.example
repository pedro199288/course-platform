DATABASE_URL="postgresql://course:course@localhost:5432/course_platform"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate: openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=             # Resend API key for transactional emails
EMAIL_FROM=noreply@platform.com  # Sender address
BETTER_AUTH_TRUSTED_ORIGINS=     # Comma-separated, e.g. https://*.platform.com
STRIPE_SECRET_KEY=               # Stripe secret key (sk_test_...)
STRIPE_WEBHOOK_SECRET=           # Stripe webhook signing secret (whsec_...)
BUNNY_STREAM_LIBRARY_ID=         # Bunny Stream video library ID
BUNNY_STREAM_API_KEY=            # Bunny Stream API key (from library settings)
BUNNY_STREAM_CDN_HOSTNAME=       # Bunny Stream CDN hostname (e.g. vz-abc123.b-cdn.net)
BUNNY_STREAM_CDN_TOKEN_KEY=      # Bunny CDN token authentication key (from CDN settings)
BUNNY_WEBHOOK_SECRET=            # Secret query param for Bunny webhook verification
